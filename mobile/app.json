{
  "expo": {
    "name": "Brim",
    "slug": "brim",
    "platforms": [
      "ios"
    ],
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.brim.companion",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSLocalNetworkUsageDescription": "Brim talks to your hat over your local Wi-Fi to hear its warnings and directions.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "microphonePermission": false
        }
      ]
    ]
  }
}
