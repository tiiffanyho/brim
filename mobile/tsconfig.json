{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "paths": {
      "@schema": ["../shared/gen/events.ts"],
      "@web/*": ["../app/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../shared/gen/events.ts"]
}
