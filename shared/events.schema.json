{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brim.local/events.schema.json",
  "title": "Brim events and API payloads",
  "description": "Single source of truth for every event (device -> app_server -> PWA) and every REST payload. Run `node shared/gen/generate.mjs` after editing. Timestamps named t_*_mono_ms are CLOCK_MONOTONIC milliseconds on the device; *_at fields are ISO-8601 UTC wall-clock strings. There is no identity anywhere in this schema: no names, no face data, no person ids. People are anonymous tracks that are forgotten within 30 minutes.",
  "x-schema-version": 2,
  "$defs": {
    "Direction": {
      "description": "Where something is relative to the wearer's head, or which way to move.",
      "type": "string",
      "enum": ["left", "ahead", "right", "unknown"]
    },
    "Proximity": {
      "description": "How close something is, estimated from how much of the frame it fills. There is no distance sensor on the hat, so this is always an estimate from the image: `close` = act now, `near` = worth saying, `far` = ignore.",
      "type": "string",
      "enum": ["close", "near", "far", "unknown"]
    },
    "ObstacleKind": {
      "description": "What the obstacle is. `obstacle` means 'something is there' — used when the detector is confident that an obstacle exists but not confident about the label (we never name what we did not see with confidence).",
      "type": "string",
      "enum": ["person", "chair", "table", "door", "pole", "stairs", "vehicle", "bicycle", "obstacle"]
    },
    "SafetyKind": {
      "description": "The three things that interrupt everything else. All are judged from the camera image.",
      "type": "string",
      "enum": ["person_close", "object_close", "phone_raised"]
    },
    "Severity": {
      "type": "string",
      "enum": ["info", "warning", "critical"]
    },
    "FaultAction": {
      "description": "What the system did about a fault.",
      "type": "string",
      "enum": ["restarting", "degraded", "recovered", "info"]
    },
    "ComponentState": {
      "type": "string",
      "enum": ["ok", "degraded", "down", "stub"]
    },
    "CommandKind": {
      "description": "Commands app_server sends to brim. `reload_settings` carries the new settings; `speak_pairing_pin` carries the PIN so the wearer hears it in the earpiece.",
      "type": "string",
      "enum": ["reload_settings", "speak_pairing_pin"]
    },
    "ActivityKind": {
      "type": "string",
      "enum": ["person", "obstacle"]
    },
    "Sensitivity": {
      "type": "string",
      "enum": ["low", "normal", "high"]
    },

    "ComponentStatus": {
      "type": "object",
      "required": ["name", "state"],
      "properties": {
        "name": { "type": "string" },
        "state": { "$ref": "#/$defs/ComponentState" },
        "detail": { "type": "string" }
      }
    },

    "PersonSeenEvent": {
      "description": "Someone is in view. Anonymous: a track_id only, never a name or face data. Spoken as 'person on your left, close by'.",
      "type": "object",
      "required": ["type", "seq", "source", "t_mono_ms", "track_id", "direction", "proximity", "confidence"],
      "properties": {
        "type": { "const": "person_seen" },
        "seq": { "type": "integer", "description": "Per-source counter; gaps mean dropped events." },
        "source": { "type": "string" },
        "t_mono_ms": { "type": "integer", "description": "Device CLOCK_MONOTONIC ms when emitted." },
        "t_capture_mono_ms": { "type": "integer", "description": "Monotonic ms of the camera frame this came from." },
        "t_relay_mono_ms": { "type": "integer", "description": "Stamped by app_server when relayed to the phone." },
        "track_id": { "type": "integer", "description": "Stable while this person stays in view; forgotten within 30 minutes. Not an identity." },
        "direction": { "$ref": "#/$defs/Direction" },
        "proximity": { "$ref": "#/$defs/Proximity" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "area_frac": { "type": "number", "description": "Fraction of the frame the box fills — the evidence behind `proximity`." }
      }
    },
    "ObstacleSeenEvent": {
      "description": "A non-person obstacle is in view. Spoken as 'chair ahead'. `label` is only set to something specific when the detector is confident.",
      "type": "object",
      "required": ["type", "seq", "source", "t_mono_ms", "label", "direction", "proximity", "confidence"],
      "properties": {
        "type": { "const": "obstacle_seen" },
        "seq": { "type": "integer" },
        "source": { "type": "string" },
        "t_mono_ms": { "type": "integer" },
        "t_capture_mono_ms": { "type": "integer" },
        "t_relay_mono_ms": { "type": "integer" },
        "track_id": { "type": "integer" },
        "label": { "$ref": "#/$defs/ObstacleKind" },
        "direction": { "$ref": "#/$defs/Direction" },
        "proximity": { "$ref": "#/$defs/Proximity" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "area_frac": { "type": "number" }
      }
    },
    "ClearPathEvent": {
      "description": "Where it is safe to move. `clear` false means no direction is safe and the wearer is told 'Path unclear, stop' — never guess a direction.",
      "type": "object",
      "required": ["type", "seq", "source", "t_mono_ms", "clear", "direction", "text"],
      "properties": {
        "type": { "const": "clear_path" },
        "seq": { "type": "integer" },
        "source": { "type": "string" },
        "t_mono_ms": { "type": "integer" },
        "t_capture_mono_ms": { "type": "integer" },
        "t_relay_mono_ms": { "type": "integer" },
        "clear": { "type": "boolean", "description": "True only when `direction` is a direction we are sure about." },
        "direction": { "$ref": "#/$defs/Direction" },
        "text": { "type": "string", "description": "Exactly what was spoken, e.g. 'Clear path ahead' or 'Path unclear, stop'." },
        "blocked": { "type": "array", "items": { "$ref": "#/$defs/Direction" }, "description": "Directions ruled out this decision." }
      }
    },
    "SafetyAlertEvent": {
      "description": "Highest speech priority: something close in front, or a phone held up toward the wearer.",
      "type": "object",
      "required": ["type", "seq", "source", "t_mono_ms", "kind", "severity", "text", "direction"],
      "properties": {
        "type": { "const": "safety_alert" },
        "seq": { "type": "integer" },
        "source": { "type": "string" },
        "t_mono_ms": { "type": "integer" },
        "t_capture_mono_ms": { "type": "integer" },
        "t_relay_mono_ms": { "type": "integer" },
        "kind": { "$ref": "#/$defs/SafetyKind" },
        "severity": { "$ref": "#/$defs/Severity" },
        "text": { "type": "string" },
        "direction": { "$ref": "#/$defs/Direction" },
        "proximity": { "$ref": "#/$defs/Proximity" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "FaultEvent": {
      "type": "object",
      "required": ["type", "seq", "source", "t_mono_ms", "component", "action", "message"],
      "properties": {
        "type": { "const": "fault" },
        "seq": { "type": "integer" },
        "source": { "type": "string" },
        "t_mono_ms": { "type": "integer" },
        "t_relay_mono_ms": { "type": "integer" },
        "component": { "type": "string" },
        "action": { "$ref": "#/$defs/FaultAction" },
        "message": { "type": "string" },
        "restart_count": { "type": "integer" }
      }
    },
    "HealthEvent": {
      "description": "Periodic (1 Hz) device health snapshot.",
      "type": "object",
      "required": ["type", "seq", "source", "t_mono_ms", "uptime_s", "fps", "cpu_pct", "pipeline_latency_ms", "speak_queue_len", "components"],
      "properties": {
        "type": { "const": "health" },
        "seq": { "type": "integer" },
        "source": { "type": "string" },
        "t_mono_ms": { "type": "integer" },
        "t_relay_mono_ms": { "type": "integer" },
        "uptime_s": { "type": "number" },
        "fps": { "type": "number" },
        "cpu_pct": { "type": "number" },
        "temp_c": { "type": "number" },
        "mem_used_mb": { "type": "number" },
        "pipeline_latency_ms": { "type": "number", "description": "Capture -> event latency, rolling average." },
        "speak_queue_len": { "type": "integer" },
        "components": { "type": "array", "items": { "$ref": "#/$defs/ComponentStatus" } }
      }
    },
    "BrimEvent": {
      "description": "Any event on the bus / WebSocket. Discriminated by `type`.",
      "x-discriminator": "type",
      "oneOf": [
        { "$ref": "#/$defs/PersonSeenEvent" },
        { "$ref": "#/$defs/ObstacleSeenEvent" },
        { "$ref": "#/$defs/ClearPathEvent" },
        { "$ref": "#/$defs/SafetyAlertEvent" },
        { "$ref": "#/$defs/FaultEvent" },
        { "$ref": "#/$defs/HealthEvent" }
      ]
    },

    "Settings": {
      "type": "object",
      "required": ["volume", "speech_rate", "announce_people", "announce_obstacles", "safety_sensitivity", "info_min_interval_s"],
      "properties": {
        "volume": { "type": "integer", "minimum": 0, "maximum": 100 },
        "speech_rate": { "type": "number", "minimum": 0.5, "maximum": 2.0 },
        "announce_people": { "type": "boolean", "description": "Say where people are. Safety alerts about people are always spoken." },
        "announce_obstacles": { "type": "boolean", "description": "Name obstacles and their side." },
        "safety_sensitivity": { "$ref": "#/$defs/Sensitivity" },
        "info_min_interval_s": { "type": "integer", "minimum": 10, "maximum": 600, "description": "Minimum seconds between low-priority announcements (people, obstacles). Safety and navigation are never delayed by this." }
      }
    },

    "Command": {
      "description": "app_server -> brim control message (never leaves the device).",
      "type": "object",
      "required": ["type", "t_mono_ms", "command"],
      "properties": {
        "type": { "const": "command" },
        "t_mono_ms": { "type": "integer" },
        "command": { "$ref": "#/$defs/CommandKind" },
        "settings": { "$ref": "#/$defs/Settings", "description": "Set on reload_settings: brim applies these without reading SQLite." },
        "pin": { "type": "string", "description": "Set on speak_pairing_pin: the 6-digit pairing PIN to speak in the earpiece." }
      }
    },

    "ActivityItem": {
      "description": "One thing the hat noticed. No identity: people are anonymous. Purged 30 minutes after it was seen.",
      "type": "object",
      "required": ["id", "kind", "direction", "proximity", "seen_at"],
      "properties": {
        "id": { "type": "integer" },
        "kind": { "$ref": "#/$defs/ActivityKind" },
        "label": { "$ref": "#/$defs/ObstacleKind", "description": "Set when kind is obstacle." },
        "track_id": { "type": "integer" },
        "direction": { "$ref": "#/$defs/Direction" },
        "proximity": { "$ref": "#/$defs/Proximity" },
        "confidence": { "type": "number" },
        "seen_at": { "type": "string" }
      }
    },
    "Alert": {
      "type": "object",
      "required": ["id", "kind", "severity", "text", "created_at"],
      "properties": {
        "id": { "type": "integer" },
        "kind": { "$ref": "#/$defs/SafetyKind" },
        "severity": { "$ref": "#/$defs/Severity" },
        "text": { "type": "string" },
        "created_at": { "type": "string" }
      }
    },
    "HealthResponse": {
      "type": "object",
      "required": ["server_uptime_s", "brim_connected", "ws_clients", "db_ok", "restart_count"],
      "properties": {
        "server_uptime_s": { "type": "number" },
        "brim_connected": { "type": "boolean", "description": "A brim event arrived in the last 3 s." },
        "last_event_age_ms": { "type": "integer" },
        "ws_clients": { "type": "integer" },
        "db_ok": { "type": "boolean" },
        "restart_count": { "type": "integer" },
        "relay_latency_ms": { "type": "number", "description": "Average brim emit -> app_server relay delay." },
        "last_health": { "$ref": "#/$defs/HealthEvent" }
      }
    },
    "PairRequest": {
      "type": "object",
      "required": ["pin"],
      "properties": { "pin": { "type": "string", "pattern": "^[0-9]{6}$" } }
    },
    "PairResponse": {
      "type": "object",
      "required": ["ok"],
      "properties": { "ok": { "type": "boolean" } }
    },
    "ApiError": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": { "type": "string" },
        "retry_after_s": { "type": "integer" }
      }
    }
  }
}
